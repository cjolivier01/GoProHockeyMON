{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build",
      "type": "shell",
      "command": "/home/colivier/.platformio/penv/bin/pio",
      "args": [
        "run"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Upload",
      "type": "shell",
      "command": "/home/colivier/.platformio/penv/bin/pio",
      "args": [
        "run",
        "-t",
        "upload"
      ],
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Monitor",
      "type": "shell",
      "command": "/home/colivier/.platformio/penv/bin/pio",
      "args": [
        "device",
        "monitor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Make: Generate compile_commands.json",
      "type": "shell",
      "command": "make",
      "args": [
        "compile_commands.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
